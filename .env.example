# ── Core (only OWNER_NUMBER is required) ──
OWNER_NUMBER=237682432296
PREFIX=.
MODE=public
BOT_NAME=🔥🥰𝑴𝑶𝑵𝑨 𝑳𝑰𝑺𝑨 𝑽𝟐🤭🔥
OWNER_NAME=PROGRESS TECH

# ── Session persistence ──
# Optional. Without it the bot must re-pair after every restart.
MONGODB_URI=
SESSION_ID=

# ── Branding / channel ──
CHANNEL_LINK=https://whatsapp.com/channel/0029Vb8rLzOCRs1j79bllH05
CHANNEL_JID=120363431455356251@newsletter
GROUP_LINK=
OWNER_LINK=https://wa.me/237682432296
IMAGE_PATH=https://files.catbox.moe/4dwiou.png

# ── AI chat (translate / summarize / code / ai) ──
# Any OpenAI-compatible endpoint. These are YOUR keys, not the platform's.
USER_LLM_API_KEY=
USER_LLM_BASE_URL=https://api.openai.com/v1
USER_LLM_MODEL=gpt-4o-mini

# ── Video generation (Replicate) ──
REPLICATE_API_TOKEN=
REPLICATE_T2V_MODEL=wan-video/wan-2.2-t2v-fast
REPLICATE_I2V_MODEL=wan-video/wan-2.2-i2v-fast
REPLICATE_AVATAR_MODEL=prunaai/p-video-avatar

# ── Optional Telegram notifications ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Automation toggles ──
AUTO_STATUS_SEEN=true
AUTO_STATUS_REACT=true
READ_MESSAGE=false
BOT_ONLINE=true
ANTIDELETE=false
ANTI_CALL=false
GROUP_WELCOME=false
GROUP_GOODBYE=false
DEBUG=false
